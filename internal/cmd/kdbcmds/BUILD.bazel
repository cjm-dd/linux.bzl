load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "kdbcmds_lib",
    srcs = ["main.go"],
    importpath = "github.com/hermeticbuild/linux.bzl/internal/cmd/kdbcmds",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "kdbcmds",
    embed = [":kdbcmds_lib"],
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "kdbcmds_test",
    srcs = ["main_test.go"],
    embed = [":kdbcmds_lib"],
)
